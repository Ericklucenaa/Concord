{
  "name": "concord-desktop",
  "version": "1.0.1",
  "author": "Concord Team",
  "description": "Concord Desktop Client for Windows",
  "main": "src/main/index.cjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "dev": "vite",
    "build:renderer": "vite build",
    "build": "vite build",
    "start": "electron .",
    "dist:win": "vite build && electron-builder --win --x64",
    "package:win": "vite build && electron-builder --win --x64",
    "publish:version": "node publish_version.js"
  },
  "build": {
    "appId": "com.concord.app",
    "productName": "Concord",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Concord"
    }
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.1.0"
  }
}