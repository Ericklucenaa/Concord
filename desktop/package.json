{
  "name": "concord-desktop",
  "version": "1.2.0",
  "type": "module",
  "author": "Concord Team",
  "description": "Concord — chat, voz e transmissão de tela",
  "main": "src/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "build": "vite build",
    "build:renderer": "vite build",
    "start": "electron .",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:emulators": "firebase emulators:exec --project demo-concord --only firestore,auth \"vitest run\"",
    "dist:win": "vite build && electron-builder --win --x64 --publish never",
    "package:win": "npm run dist:win",
    "test:unit": "vitest run tests/unit"
  },
  "build": {
    "appId": "com.concord.app",
    "productName": "Concord",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**"
    ],
    "protocols": [
      {
        "name": "Concord",
        "schemes": [
          "concord"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Concord",
      "artifactName": "Concord-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Concord-Portable-${version}.${ext}"
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase": "^12.17.1",
    "globals": "^17.13.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.1.0",
    "vitest": "^3.2.7"
  }
}
