# Concord Desktop — Backend connection configuration
#
# IMPORTANT: without these set at build time, the packaged app defaults to
# http://localhost:4000, which only works if every user runs their own local
# backend copy (they won't be able to talk to each other). To let people on
# different computers chat/call each other for real, point both of these at
# your one shared, publicly hosted backend instance (Render/Railway/Fly.io/
# Cloud Run — Firebase Hosting alone cannot run the Socket.IO server).

VITE_API_URL=https://your-backend-domain.com/api
VITE_SOCKET_URL=https://your-backend-domain.com
