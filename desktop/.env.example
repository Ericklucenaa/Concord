# Concord — optional build-time configuration
#
# All app data lives in Firebase (project concord-3af70); no backend URL is
# needed. The only optional setting is a TURN relay, which lets voice and
# screen sharing work behind strict NATs (corporate networks, many 4G
# carriers). Get credentials from a TURN provider (e.g. Metered, Twilio,
# Cloudflare Calls) or a self-hosted coturn server.

VITE_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Run the client against local Firebase emulators (used by the tests).
# VITE_FIREBASE_EMULATOR=1
