# Staging build: copy to .env.staging and run `npx vite build --mode staging`
# (or `npm run dev -- --mode staging`). Create a second Firebase project
# (e.g. concord-staging), add a web app and paste its config here, then
# deploy rules there with `firebase deploy --only firestore -P staging`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=concord-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=concord-staging
VITE_FIREBASE_STORAGE_BUCKET=concord-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
