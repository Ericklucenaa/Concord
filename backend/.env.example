# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Security
# REQUIRED in production. Generate a unique secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Leave empty in development to auto-generate an ephemeral per-run secret.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# "Login with Google" — server-side Firebase ID token verification.
# Optional: if unset, the /api/auth/google endpoint is disabled (returns 503)
# instead of trusting unverified identities.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternatively, point to a service-account JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Database
DB_PATH=./database/concord.sqlite

# WebRTC STUN & TURN
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
