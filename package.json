{
  "name": "concord",
  "version": "1.1.0",
  "type": "module",
  "description": "Desktop communication application with WebRTC Voice and Screen Sharing",
  "main": "desktop/src/main/index.cjs",
  "scripts": {
    "postinstall": "npm install --prefix desktop",
    "start": "node dev.js",
    "dev": "node dev.js",
    "dev:web": "npm run dev --prefix desktop",
    "dev:desktop": "npm run dev --prefix desktop",
    "lint": "npm run lint --prefix desktop",
    "test": "npm run test:emulators --prefix desktop",
    "build:desktop": "npm run build --prefix desktop",
    "dist:win": "npm run dist:win --prefix desktop",
    "package:win": "npm run dist:win --prefix desktop"
  },
  "keywords": [
    "chat",
    "webrtc",
    "voice",
    "screenshare",
    "electron",
    "desktop"
  ],
  "author": "",
  "license": "MIT"
}
